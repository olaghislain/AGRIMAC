NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_ORIGINS=http://localhost:5175

POSTGRES_DB=agrimac_dev
POSTGRES_USER=agrimac_dev
POSTGRES_PASSWORD=agrimac_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://agrimac_dev:agrimac_dev_password@localhost:5433/agrimac_dev?schema=public

# Development-only seed password. Replace/remove before any shared environment.
SEED_PASSWORD=AGRIMAC_DEV_ONLY_CHANGE_ME_123!
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
OTP_DEV_EXPOSE=false

# Phase 8/9 private storage and payment provider configuration
UPLOAD_DIR=./storage/private
PAYMENT_EXPIRY_MINUTES=30
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-secret
# Configure provider-specific URLs and secrets only when the provider account is active.
# PAYMENT_MTN_MOMO_INIT_URL=
# PAYMENT_MTN_MOMO_API_KEY=
# PAYMENT_MTN_MOMO_WEBHOOK_SECRET=
# PAYMENT_MOOV_MONEY_INIT_URL=
# PAYMENT_MOOV_MONEY_API_KEY=
# PAYMENT_MOOV_MONEY_WEBHOOK_SECRET=
# PAYMENT_FLOOZ_INIT_URL=
# PAYMENT_FLOOZ_API_KEY=
# PAYMENT_FLOOZ_WEBHOOK_SECRET=
# PAYMENT_CELTIS_SBIN_INIT_URL=
# PAYMENT_CELTIS_SBIN_API_KEY=
# PAYMENT_CELTIS_SBIN_WEBHOOK_SECRET=

# Scraping is disabled by default. The local fixture is manual-only.
SCRAPING_SCHEDULER_ENABLED=false
OTP_RESEND_COOLDOWN_SECONDS=60
